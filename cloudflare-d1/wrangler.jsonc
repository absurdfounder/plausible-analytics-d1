{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plausible-d1",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      "database_id": "7e2114fa-047a-406c-8bab-e52fb41a0f32",
      "migrations_dir": "migrations"
    }
  ]
}
